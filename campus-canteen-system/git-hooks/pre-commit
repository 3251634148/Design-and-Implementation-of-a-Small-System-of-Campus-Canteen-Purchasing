#!/bin/bash

# Pre-commit hook for Biome format and lint checks
# This script runs Biome checks only on staged files

set -e

echo "🔍 Running pre-commit checks..."
echo "DEBUG: Hook is being executed!"

# Get list of staged files (only committed files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No staged files to check"
    exit 0
fi

# Filter for files that Biome can process (JS, TS, JSX, TSX, JSON)
BIOME_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx|json)$' || true)

if [ -z "$BIOME_FILES" ]; then
    echo "✅ No JavaScript/TypeScript files to check"
    exit 0
fi

echo "📁 Checking files:"
echo "$BIOME_FILES" | sed 's/^/  - /'

# Check if biome is available
if ! command -v npx &> /dev/null; then
    echo "❌ npx not found. Please install Node.js and npm."
    exit 1
fi

# Check if biome.json exists
if [ ! -f "biome.json" ]; then
    echo "❌ biome.json not found. Please ensure Biome is configured."
    exit 1
fi

echo ""
echo "🎨 Running Biome formatter check..."

# Check formatting (don't auto-fix, just check)
if ! npx @biomejs/biome format --check $BIOME_FILES; then
    echo ""
    echo "❌ Formatting issues found!"
    echo "💡 Run the following command to fix formatting:"
    echo "   npx @biomejs/biome format --write $BIOME_FILES"
    echo ""
    echo "Or run: npx @biomejs/biome format --write ."
    exit 1
fi

echo "✅ Formatting check passed"

echo ""
echo "🔍 Running Biome linter check..."

# Run linter check
if ! npx @biomejs/biome lint $BIOME_FILES; then
    echo ""
    echo "❌ Linting issues found!"
    echo "💡 Run the following command to see detailed issues:"
    echo "   npx @biomejs/biome lint $BIOME_FILES"
    echo ""
    echo "Some issues can be auto-fixed with:"
    echo "   npx @biomejs/biome lint --apply $BIOME_FILES"
    exit 1
fi

echo "✅ Linting check passed"

echo ""
echo "🎉 All pre-commit checks passed! Ready to commit."